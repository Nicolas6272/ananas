{
  "expo": {
    "name": "sollow",
    "slug": "sollow",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.nicolas6272.sollow",
      "appleTeamId": "F95XF4TLUS",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.galaxies.sollow"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.nicolas6272.sollow"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@bacons/apple-targets",
      "expo-background-task"
    ],
    "scheme": "sollow",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5114113f-9515-4e5c-9191-443fdc233ace"
      }
    },
    "owner": "nicolas6272"
  }
}
